#!/usr/bin/env python3
import sys, zlib, struct, os
args = [a for a in sys.argv[1:] if not a.startswith('-')]
args = [a for a in args if a not in ('150','200')]
pdf, out_base = args[0], args[1]
wide = 'deck' in os.path.basename(pdf).lower() or 'slide' in os.path.basename(pdf).lower()
W, H = (1280, 720) if wide else (620, 800)
def page(path, n):
    rows = []
    for y in range(H):
        row = bytearray([0])
        for x in range(W):
            px = (255, 255, 255)
            if wide:
                if y < 12 or y > H-12 or x < 12 or x > W-12: px = (238, 242, 240)
                elif 70 < y < 118 and 80 < x < 700: px = (24, 58, 44)
                elif y % 44 == 0 and 190 < y < H-140 and 80 < x < W-320: px = (150, 162, 156)
                elif H-150 < y < H-60 and W-320 < x < W-90: px = (216, 232, 222)
            else:
                if 46 < y < 76 and 50 < x < 430: px = (24, 58, 44)
                elif y % 30 == 0 and 130 < y < H-80 and 50 < x < W-60: px = (155, 165, 160)
                elif H-64 < y < H-40 and 50 < x < 190: px = (47, 125, 93)
            row += bytes(px)
        rows.append(bytes(row))
    raw = b''.join(rows)
    def chunk(t, d):
        c = t + d
        return struct.pack('>I', len(d)) + c + struct.pack('>I', zlib.crc32(c))
    open(path,'wb').write(b'\x89PNG\r\n\x1a\n'
        + chunk(b'IHDR', struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0))
        + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))
page(f"{out_base}-1.png", 1); page(f"{out_base}-2.png", 2)
