# Copy to .env and adjust. Every value is optional.

# Port the server listens on (Railway sets this automatically)
PORT=3000

# Where the SQLite database and uploads live.
# On Railway, attach a volume and point this at its mount path, e.g. /data
DATA_DIR=./data

# Public base URL, used for photo links inside host notification emails
PUBLIC_URL=http://localhost:3000

# Set to "production" when deployed
NODE_ENV=development

# Only if you terminate TLS elsewhere and cookies must stay non-Secure
# INSECURE_COOKIES=true
