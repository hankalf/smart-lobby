# Copy to .env and adjust. Every value is optional.

# Port the server listens on (Railway sets this automatically)
PORT=3000

# Where the SQLite database and uploads live. This is for LOCAL runs only.
#
# Do NOT copy this line into Railway (or any host). A relative path like ./data
# points at the container filesystem, which is wiped on every deploy, taking the
# database and all uploads with it. On Railway either leave DATA_DIR unset — an
# attached volume is detected automatically — or set it to the volume's mount
# path, e.g. DATA_DIR=/data
DATA_DIR=./data

# Public base URL, used for photo links inside host notification emails
PUBLIC_URL=http://localhost:3000

# Set to "production" when deployed
NODE_ENV=development

# Only if you terminate TLS elsewhere and cookies must stay non-Secure
# INSECURE_COOKIES=true
